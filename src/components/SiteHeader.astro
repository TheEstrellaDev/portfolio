---
import ThemeToggle from './ThemeToggle.astro';
const links: [string, string][] = [['Sobre mí', '#sobre-mi'], ['Proyectos', '#proyectos'], ['Servicios', '#servicios'], ['Trayectoria', '#proceso'], ['Contacto', '#contacto']];
---
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<header class="header" data-header><div class="container nav-container">
  <a href="#inicio" class="logo" aria-label="TheEstrellaDev, inicio">&lt;TheEstrella<span>Dev</span>/&gt;</a>
  <button class="mobile-menu-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label="Abrir menú de navegación" data-menu-toggle><span></span><span></span></button>
  <nav id="nav-links" class="nav-links" aria-label="Navegación principal">
    {links.map(([label, href]) => <a href={href} class="nav-link">{label}</a>)}
    <a class="nav-contact" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
    <ThemeToggle />
  </nav>
</div></header>
