---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
const projects = [
  { title: 'Añejo Restaurant, Toronto', description: 'Sitio web para restaurante, enfocado en reservas y ubicación en Toronto.', category: 'negocios', image: 'webs/negocios/negocios1.webp', href: 'https://anejo.ca/en/locations/on/toronto/600-king-street-west' },
  { title: 'Landscaping Leaf Experts Vancouver', description: 'Sitio web para servicios de jardinería y paisajismo, con enfoque en captación de leads.', category: 'negocios', image: 'webs/negocios/negocios2.webp', href: 'https://landscapingvancouverbc.net' },
  { title: 'Hospital San Agustín', description: 'Sitio web institucional en Zacatecas con información de servicios y especialidades.', category: 'negocios', image: 'webs/negocios/negocios3.webp', href: 'https://hospitalsanagustin.com.mx' },
  { title: 'Prestige Construction & Management', description: 'Sitio web corporativo para empresa de construcción y remodelación en Toronto.', category: 'negocios', image: 'webs/negocios/negocios4.webp', href: 'https://prestigegroupc.com' },
  { title: "Emily's Barber Shop", description: 'Sitio web para barbería en Toronto con información de servicios y reservas.', category: 'negocios', image: 'webs/negocios/negocios5.webp', href: 'https://emilybarbershop.com' },
  { title: 'Víctor Hugo Monreal — Fisioterapia', description: 'Landing page para especialista en fisioterapia, con contacto directo vía WhatsApp.', category: 'landing', image: 'webs/landingpages/landing1.webp', href: 'https://fisiovictor.netlify.app' },
  { title: 'Ciudad Maderas — Inversión', description: 'Landing page bilingüe para presentar oportunidades inmobiliarias mexicanas a inversionistas canadienses.', category: 'landing', image: 'webs/landingpages/landing2.webp', href: 'https://ciudad-maderas-canada.netlify.app' },
  { title: 'MediCats Clínica Felina', description: 'Landing page para clínica veterinaria especializada en gatos.', category: 'landing', image: 'webs/landingpages/landing3.webp', href: 'https://medicats-zacatecas.netlify.app' },
  { title: '¡La Jarocha!', description: 'Landing page para negocio de comida a domicilio con menú y pedidos por WhatsApp.', category: 'landing', image: 'webs/landingpages/landing4.webp', href: 'https://lajarocha.netlify.app' },
  { title: 'MCD Odontología', description: 'Landing page para consultorio dental, con ubicaciones y opciones de contacto.', category: 'landing', image: 'webs/landingpages/landing5.webp', href: 'https://mcdarturoibarrav.netlify.app' },
  { title: 'Casa Turquesa Loft Bacalar', description: 'Landing page para alojamiento turístico con sistema de reservación integrado.', category: 'landing', image: 'webs/landingpages/landing6.webp', href: 'https://casaturquesaloft.netlify.app' },
  { title: 'Alex Rosas Event Planner', description: 'Sitio para planeación de eventos, enfocado en agendar consultas.', category: 'landing', image: 'webs/landingpages/landing7.webp', href: 'https://event-project-w.netlify.app' },
  { title: 'Alta Tierra Ensenada', description: 'Landing page para desarrollo inmobiliario residencial en Ensenada.', category: 'portafolios', image: 'webs/portfolios/portafolio1.webp', href: 'https://altatierra-baja.netlify.app' },
  { title: 'Los Cocuyos Jalisco', description: 'Landing page para venta de terrenos en Jalisco, con diseño enfocado en la naturaleza.', category: 'portafolios', image: 'webs/portfolios/portafolio2.webp', href: 'https://terrenos-playa-el-chorro.netlify.app' },
  { title: 'Terrenos Campestres Zacatecas', description: 'Landing page para venta de terrenos campestres, con llamadas a la acción directas.', category: 'portafolios', image: 'webs/portfolios/portafolio3.webp', href: 'https://juan-torres.netlify.app' },
  { title: 'Pingo Club', description: 'Sitio para una estética infantil en Guadalupe, Zacatecas, con galería, servicios y solicitud de citas por WhatsApp.', category: 'landing', image: 'projects/pingo-club-card.webp', imageAlt: 'Interior colorido de Pingo Club, estética infantil en Guadalupe, Zacatecas', href: 'https://theestrelladev.github.io/pingo-club/', tags: ['React', 'TypeScript', 'Vite', 'GitHub Actions'], repository: 'https://github.com/TheEstrellaDev/pingo-club' },
  { title: 'Empanadas con Causa', description: 'Sitio de pedidos para un emprendimiento familiar en Calgary: presenta sabores y cajas, permite armar pedidos y enviarlos por WhatsApp o Facebook. El sitio comunica que el 10% de cada compra se destina a colectivos de madres buscadoras en Guadalajara.', category: 'negocios', image: 'projects/empanadas-con-causa.webp', imageAlt: 'Empanadas caseras recién horneadas en una charola', href: 'https://empanadasconcausa.netlify.app' },
  { title: 'Fusión Zac', description: 'Sitio para servicios de sonido e iluminación en Zacatecas, con paquetes para XV años, bodas y graduaciones, galería de videos y contacto directo para cotizar.', category: 'negocios', image: 'projects/fusion-zac.webp', imageAlt: 'Fiesta con público bailando y luces frente a la Catedral de Zacatecas', href: 'https://sonidofusionzac.lat', tags: ['React', 'TypeScript', 'Vite'] },
];
const skills = ['HTML5 semántico', 'CSS3', 'JavaScript', 'TypeScript', 'React', 'Astro', 'Diseño responsive', 'Accesibilidad web', 'Git & GitHub', 'Linux'];
const services = [
  ['01', 'Sitios web para negocios', 'Presencia profesional para empresas y comercios que necesitan explicar sus servicios, generar confianza y recibir consultas.'],
  ['02', 'Landing pages', 'Páginas enfocadas en presentar una oferta, servicio o campaña con un recorrido claro hacia la acción.'],
  ['03', 'Portafolios profesionales', 'Sitios personales para mostrar proyectos y trayectoria a clientes y equipos de contratación.'],
  ['04', 'Rediseño y mantenimiento', 'Modernización de sitios existentes, ajustes responsive, correcciones y actualizaciones de contenido.'],
];
---
<Layout>
  <main id="contenido">
    <section id="inicio" class="hero section-wrap">
      <div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div>
      <div class="container hero-layout">
        <div class="hero-copy"><span class="eyebrow"><span class="status-dot"></span> ZACATECAS, MÉXICO · DISPONIBLE PARA PROYECTOS</span>
          <h1>Hola, soy José.<br /><span>Construyo para</span><br />la web de hoy.</h1>
          <p class="hero-description">Diseño y desarrollo experiencias web rápidas, claras y útiles para personas y negocios.</p>
          <div class="hero-actions"><a class="button button-primary" href="#proyectos">Explorar proyectos <span aria-hidden="true">↘</span></a><a class="button button-quiet" href="mailto:cruzestrella915@gmail.com">Conversemos <span aria-hidden="true">↗</span></a></div>
          <div class="hero-meta"><span>Freelance · Desarrollo web</span><span>UVEG · Ingeniería en Desarrollo de Software</span></div>
        </div>
        <div class="hero-visual"><div class="portrait-frame"><img src="images/me.jpg" alt="José Estrella, desarrollador web" width="768" height="1024" fetchpriority="high" /><span class="portrait-index">FIG. 01 — JOSÉ ESTRELLA</span></div><div class="code-note"><span class="code-dot"></span> Build something useful<span class="note-mark">↗</span></div><div class="hero-stamp" aria-hidden="true">DESIGN<br />&amp; CODE<br /><b>✳</b></div></div>
      </div><a class="scroll-cue" href="#sobre-mi"><span>DESPLAZAR PARA EXPLORAR</span><i></i></a>
    </section>
    <section id="sobre-mi" class="section-wrap about-section"><div class="container about-grid"><div class="section-index"><span>01 / PERFIL</span><span class="index-line"></span></div><div class="about-main"><h2>La tecnología debe sentirse <span>humana.</span></h2><div class="about-columns"><div><p>Soy desarrollador web freelance y estudiante de Ingeniería en Desarrollo de Software en la UVEG. Transformo necesidades reales en experiencias web claras, funcionales y atractivas.</p><p>Originario de Zacatecas, México, también vivo en London, Ontario, Canadá y viajo entre ambas ciudades. Esa experiencia amplía mi perspectiva sobre distintos entornos y necesidades.</p></div><div><p>Además del desarrollo web, trabajo como programador de videojuegos indie para estudios locales en Canadá.</p><p>Me interesan el software libre, Linux y la tecnología. Para mí, un buen sitio no solo debe verse bien: también debe ser rápido, accesible y fácil de usar.</p></div></div><a class="text-link" href="#proceso">Conoce mi trayectoria <span aria-hidden="true">↘</span></a></div></div></section>
    <section id="proyectos" class="section-wrap projects-section"><div class="container"><div class="section-index"><span>02 / TRABAJO SELECCIONADO</span><span class="index-line"></span><span>18 PROYECTOS</span></div><div class="section-heading"><div><h2>Hecho para<br /><span>ser útil.</span></h2></div><p>Proyectos digitales para negocios y personas. Cada uno responde a una necesidad y una audiencia particular.</p></div>
      <section class="workspace-feature" aria-labelledby="workspace-title"><div class="workspace-copy"><span class="case-kicker">MI ESPACIO DE TRABAJO</span><h3 id="workspace-title">Ideas, código<br /><span>y nuevas posibilidades.</span></h3><p>Un espacio para diseñar, programar y dar forma a proyectos digitales.</p><a class="project-link" href="#contacto">¿Trabajamos juntos? <span aria-hidden="true">↗</span></a></div><img src="images/workspace.webp" alt="Espacio de trabajo con laptop y dos monitores mostrando código y diseños" width="1536" height="1024" loading="lazy" decoding="async" /></section>
      <div class="project-filters" role="group" aria-label="Filtrar proyectos"><button class="filter-btn active" type="button" aria-pressed="true" data-filter="all">Todos <span>18</span></button><button class="filter-btn" type="button" aria-pressed="false" data-filter="negocios">Negocios <span>07</span></button><button class="filter-btn" type="button" aria-pressed="false" data-filter="landing">Landing pages <span>08</span></button><button class="filter-btn" type="button" aria-pressed="false" data-filter="portafolios">Portafolios <span>03</span></button></div>
      <div class="projects-grid">{projects.map((project) => <ProjectCard {...project} />)}</div></div></section>
    <section id="servicios" class="section-wrap services-section"><div class="container"><div class="section-index"><span>03 / EN QUÉ PUEDO AYUDARTE</span><span class="index-line"></span></div><div class="section-heading"><h2>Del primer boceto<br /><span>al sitio publicado.</span></h2><p>Colaboración directa y soluciones a la medida de cada proyecto.</p></div><div class="services-grid">{services.map(([number, title, description]) => <article class="service-card"><span class="service-number">{number}</span><h3>{title}</h3><p>{description}</p><span class="service-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>
    <section id="proceso" class="section-wrap journey-section"><div class="container"><div class="section-index"><span>04 / TRAYECTORIA &amp; PROCESO</span><span class="index-line"></span></div><div class="journey-grid"><div><h2>Curiosidad que<br /><span>se convierte en código.</span></h2><p>Mi camino combina aprendizaje constante, trabajo independiente y colaboración en proyectos de videojuegos indie en Canadá.</p><div class="education-card"><span class="education-date">EN CURSO</span><div><h3>Ingeniería en Desarrollo de Software</h3><p>Universidad Virtual del Estado de Guanajuato · UVEG</p></div><span class="education-mark">✳</span></div></div><div class="process-list"><div class="process-item"><span>01</span><div><h3>Escuchar</h3><p>Entiendo el objetivo, el contexto y las necesidades del proyecto.</p></div></div><div class="process-item"><span>02</span><div><h3>Planear</h3><p>Defino estructura, contenido y dirección visual.</p></div></div><div class="process-item"><span>03</span><div><h3>Construir</h3><p>Desarrollo el sitio y comparto avances para recibir comentarios.</p></div></div><div class="process-item"><span>04</span><div><h3>Entregar</h3><p>Reviso detalles y dejo el proyecto preparado para publicarse.</p></div></div></div></div></div></section>
    <section id="tecnologias" class="section-wrap tech-section"><div class="container"><div class="section-index"><span>05 / HERRAMIENTAS</span><span class="index-line"></span></div><div class="tech-layout"><h2>Una caja de herramientas<br /><span>que sigue creciendo.</span></h2><div class="tech-list">{skills.map((skill, index) => <span class="tech-item"><i>{String(index + 1).padStart(2, '0')}</i>{skill}</span>)}</div></div></div></section>
    <section id="contacto" class="section-wrap contact-section"><div class="container"><div class="section-index"><span>06 / CONTACTO</span><span class="index-line"></span></div><div class="contact-layout"><div><span class="eyebrow">¿TIENES ALGO EN MENTE?</span><h2>Hagamos algo<br /><span>que importe.</span></h2><p>Cuéntame un poco sobre tu idea y te responderé para conversar sobre los siguientes pasos.</p></div><div class="contact-card"><span class="contact-label">CONTACTO DIRECTO</span><a class="contact-email" href="mailto:cruzestrella915@gmail.com">cruzestrella915@gmail.com <span aria-hidden="true">↗</span></a><a class="contact-row" href="https://wa.me/528132152913" target="_blank" rel="noopener noreferrer">WhatsApp <span>+52 813 215 2913 ↗</span></a><a class="contact-row" href="https://github.com/TheEstrellaDev" target="_blank" rel="noopener noreferrer">GitHub <span>@TheEstrellaDev ↗</span></a><a class="contact-row" href="https://www.linkedin.com/in/jos%C3%A9-estrella-406771422/" target="_blank" rel="noopener noreferrer">LinkedIn <span>Ver perfil ↗</span></a><a class="contact-row" href="https://tiktok.com/@estrella.developer" target="_blank" rel="noopener noreferrer">TikTok <span>@estrella.developer ↗</span></a></div></div></div></section>
  </main>
  <footer class="footer"><div class="container footer-top"><a class="logo" href="#inicio">&lt;TheEstrella<span>Dev</span>/&gt;</a><span>Diseñado y desarrollado por José Estrella.</span><a href="#inicio" class="back-top">VOLVER ARRIBA ↑</a></div><div class="container footer-bottom"><span>© {new Date().getFullYear()} TheEstrellaDev</span><span>Zacatecas, MX · London, ON</span><span>Construido con Astro</span></div></footer>
  <a href="https://wa.me/528132152913" class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">WA</a>
</Layout>
